<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<!-- BD pròpia per no trepitjar la de la sessió de relacions -->
		<property name="hibernate.connection.url">jdbc:mysql://localhost:3306/videojocs_dao?createDatabaseIfNotExist=true</property>
		<property name="hibernate.connection.username">root</property>
		<property name="hibernate.connection.password">super3</property>

		<!-- create: cada execució comença amb les taules buides i el Main les omple des dels CSV -->
		<property name="hibernate.hbm2ddl.auto">create</property>

		<!--
			IMPRESCINDIBLE per al patró DAO: sense aquesta línia getCurrentSession() peta
			("No CurrentSessionContext configured").
			thread = una sessió per fil, que es tanca sola en fer commit() o rollback().
		-->
		<property name="hibernate.current_session_context_class">thread</property>

		<!-- Avui el protagonista és el codi Java, no l'SQL. Poseu-ho a true per veure les consultes. -->
		<property name="hibernate.show_sql">false</property>
		<property name="hibernate.format_sql">true</property>

		<!-- Les MATEIXES entitats de la sessió de relacions: no es copia cap classe -->
		<mapping class="relacions.Estudi"/>
		<mapping class="relacions.Videojoc"/>
		<mapping class="relacions.FitxaTecnica"/>
		<mapping class="relacions.Categoria"/>
		<mapping class="relacions.Plataforma"/>
		<mapping class="relacions.Llancament"/>
	</session-factory>
</hibernate-configuration>
